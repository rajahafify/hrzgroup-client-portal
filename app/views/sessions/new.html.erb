<%= form_with url: login_path, method: :post, local: true do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, required: true, autofocus: true, value: params[:email] %>
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password, required: true %>
  </div>
  <div>
    <%= form.submit "Sign in" %>
  </div>
<% end %>

<p style="margin-top: 1rem; font-size: 0.875rem; color: #475569;">
  Try the seeded accounts: <code>superadmin@example.com</code>, <code>admin@example.com</code>, or <code>client@example.com</code> (password: <code>password</code>).
</p>
