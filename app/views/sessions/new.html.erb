<div class="card">
  <h2>Sign in</h2>
  <%= form_with url: login_path, method: :post, local: true do |form| %>
    <div>
      <%= form.label :email %>
      <%= form.email_field :email, autofocus: true %>
    </div>

    <div>
      <%= form.label :password %>
      <%= form.password_field :password %>
    </div>

    <%= form.submit "Sign in", class: "button" %>
  <% end %>
</div>
