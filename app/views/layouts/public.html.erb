<!DOCTYPE html>
<html>
  <head>
    <title>HRZGroup Client Portal - Sign In</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      body { font-family: Arial, sans-serif; background: #1f2a44; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
      .panel { background: #fff; color: #1f2a44; padding: 2rem; border-radius: 8px; width: 100%; max-width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
      h1 { margin-top: 0; }
      label { display: block; margin-bottom: 0.5rem; font-weight: bold; }
      input { width: 100%; padding: 0.75rem; margin-bottom: 1rem; border: 1px solid #ccc; border-radius: 4px; }
      button { width: 100%; padding: 0.75rem; background: #1f2a44; color: #fff; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; }
      .flash { margin-bottom: 1rem; padding: 0.75rem; border-radius: 4px; }
      .flash.alert { background: #fdecea; color: #b3261e; }
      .flash.notice { background: #e6f4ea; color: #1f7a3d; }
      .flash.success { background: #e6f4ea; color: #1f7a3d; }
      .flash.info { background: #e8f0fe; color: #1967d2; }
      code { background: #e2e8f0; padding: 0.1rem 0.3rem; border-radius: 4px; font-size: 0.9rem; }
    </style>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="panel">
      <h1>Client Portal Login</h1>
      <% flash.each do |type, message| %>
        <div class="flash <%= type.to_s %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
