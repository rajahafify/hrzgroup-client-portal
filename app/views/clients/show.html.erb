<h1><%= t("clients.show.heading") %></h1>

<p><strong>Company:</strong> <%= @client.company_name %></p>
<p><strong>Contact Number:</strong> <%= @client.contact_no %></p>
<p><strong>Contact Email:</strong> <%= mail_to @client.contact_email %></p>

