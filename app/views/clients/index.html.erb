<h1><%= t("clients.index.heading") %></h1>

<% if current_user.admin? || current_user.superadmin? %>
  <%= link_to t("clients.index.new_client"), new_client_path %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Company</th>
      <th>Contact Number</th>
      <th>Contact Email</th>
      <% if current_user.admin? || current_user.superadmin? %>
        <th colspan="3"></th>
      <% else %>
        <th></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @clients.each do |client| %>
      <tr>
        <td><%= client.company_name %></td>
        <td><%= client.contact_no %></td>
        <td><%= client.contact_email %></td>
        <td><%= link_to "View", client_path(client) %></td>
        <% if current_user.admin? || current_user.superadmin? %>
          <td><%= link_to "Edit", edit_client_path(client) %></td>
          <td><%= button_to "Delete", client_path(client), method: :delete, data: { turbo_confirm: "Delete this client?" } %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
