<%= form_with(model: client, local: true) do |form| %>
  <% if client.errors.any? %>
    <div class="card">
      <h3><%= pluralize(client.errors.count, "error") %> prevented saving this client:</h3>
      <ul>
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :company_name %>
    <%= form.text_field :company_name %>
  </div>

  <div>
    <%= form.label :contact_no, "Contact number" %>
    <%= form.text_field :contact_no %>
  </div>

  <div>
    <%= form.label :contact_email %>
    <%= form.email_field :contact_email %>
  </div>

  <%= form.submit class: "button" %>
<% end %>
