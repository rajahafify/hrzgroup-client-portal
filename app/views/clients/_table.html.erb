<table>
  <thead>
    <tr>
      <th>Company</th>
      <th>Contact number</th>
      <th>Contact email</th>
      <% if local_assigns.fetch(:show_actions, false) %>
        <th>Actions</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% clients.each do |client| %>
      <tr>
        <td><%= link_to client.company_name, client %></td>
        <td><%= client.contact_no %></td>
        <td><%= mail_to client.contact_email %></td>
        <% if local_assigns.fetch(:show_actions, false) %>
          <td class="actions">
            <%= link_to "Edit", edit_client_path(client), class: "button button--secondary" %>
            <%= link_to "Delete", client, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "button button--danger" %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
<% if clients.empty? %>
  <p>No clients available yet.</p>
<% end %>
